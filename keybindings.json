    }
  },
  {
    "key": "ctrl+m a",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex && !editorReadonly",
    "args": {
      "snippet": "\\begin{align}\n\t${1} &= ${2} \\\\\n\t${3} &= ${4}\n\\end{align}$0"
