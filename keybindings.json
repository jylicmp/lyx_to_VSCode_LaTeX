[
  {
    "key": "cmd+m",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex && !editorReadonly",
    "args": {
      "snippet": "\\(${1:${TM_SELECTED_TEXT}}\\)$0"
    }
  },
  {
    "key": "cmd+shift+m",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex && !editorReadonly",
    "args": {
      "snippet": "\\[\n\t${1:${TM_SELECTED_TEXT}}\n\\]$0"
    }
  },
  {
    "key": "cmd+ctrl+n",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex && !editorReadonly",
