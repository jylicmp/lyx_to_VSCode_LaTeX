  {
    "key": "ctrl+m q",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == latex && !editorReadonly",
    "args": {
      "snippet": "\\begin{equation}\n\t${1}\n\\end{equation}$0"
    }
  },
  {
    "key": "cmd+alt+b",
    "command": "latex-workshop.build",
    "when": "editorLangId == latex"
  },
  {
    "key": "cmd+alt+v",
    "command": "latex-workshop.view",
    "when": "editorLangId == latex"
  },
  {
    "key": "cmd+alt+j",
    "command": "latex-workshop.synctex",
    "when": "editorTextFocus && editorLangId == latex && !editorReadonly"
  }
